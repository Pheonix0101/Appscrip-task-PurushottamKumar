{
  "name": "@appscrip/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/catalog/query.test.ts src/newsletter/validation.test.ts",
    "db:check": "node --import tsx src/db/check.ts",
    "db:seed": "node --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
